# 服务端配置 (Mac)
server:
  host: 0.0.0.0
  port: 9888
  vault_dir: ~/md-vault
  log_level: DEBUG # DEBUG for verbose watcher event/IO logging
  log_retention_days: 30  # 清理超过 N 天的 .log（每日 3am）
  lan_exposure: true

# 客户端配置 (Mac)
  log_dir: .sync/logs
client:
  server_url: http://192.168.3.147:9888
  vault_dir: ~/md-vault
  device_name: mac
  poll_interval: 300

# 隐私目录名单（可选）
privacy:
  dirs:
  - 0-隐私
ai:
  base_url: "http://localhost:1244/v1"  # or http://localhost:11434/v1 for Ollama
  api_key: "sk-splash"
  model: "Qwen3.8-Flash-Next-UD-IQ3_XXS"
  max_tokens: 16384
  context_window: 262144
  temperature: 0.6

# 后台定时 agent（可选）— 各自独立 cron / provider / prompt
# 启动时 fail-fast 校验：alias 唯一、cron 合法、prompt 文件存在、
# target_dir 在 vault 内且各 agent 互不重叠
  tools:
  max_rounds: 100
  confirm_timeout: 300
  read_doc_max_chars: 8192
background_agents:
- name: "碎片整理"
  alias: consolidator
  enabled: true
  cron: "0 2 * * *"
  target_dir: suggestions
  prompt: server/prompts/consolidator.md
  report_dir: index/reports/consolidator
  max_rounds: 30
  timeout_s: 1800
  budget_runs_per_day: 3
  budget_max_proposals: 5
  trigger:
    source: change
    events:
    - create
    arm_count: 3
    min_interval_h: 6
  model:
    model_id: "Qwen3.8-Flash-Next-UD-IQ3_XXS"
    base_url: "http://localhost:1244/v1"
    api_key: "sk-splash"
    context_window: 262144
    max_tokens: 16384
    temperature: 0.6
  tools:                                                                                    # 读×5 + propose；不持 write_doc（分界线）
  - read_doc
  - search_docs
  - list_files
  - recent_changes
  - get_related_docs
  - propose
  verbs:
  - entity_index
  - relatedness
  - summary
- name: "矛盾批注"
  alias: proofreader
  enabled: true
  cron: "0 3 * * *"                 # 每日 03:30（错开碎片整理 02:00）
  target_dir: suggestions
  prompt: server/prompts/proofreader.md
  report_dir: index/reports/proofreader
  max_rounds: 30
  timeout_s: 1800
  budget_runs_per_day: 2
  budget_max_proposals: 3
  trigger:
    source: change
    events:
    - create
    - update
    arm_count: 3
    min_interval_h: 6
  tools:
  - read_doc
  - search_docs
  - list_files
  - get_related_docs
  - propose
  verbs:
  - errata
  model:
    model_id: "Qwen3.8-Flash-Next-UD-IQ3_XXS"
    base_url: "http://localhost:1244/v1"
    api_key: "sk-splash"
    context_window: 262144
    max_tokens: 16384
    temperature: 0.6
- name: "召回诊断"
  alias: sentinel
  enabled: true
  cron: "0 9 * * 1"                   # 周一 09:00 每周心跳
  target_dir: index/reports/sentinel
  prompt: server/prompts/sentinel.md
  report_dir: .reports/sentinel
  max_rounds: 30
  timeout_s: 1800
  budget_runs_per_day: 2
  trigger:
    source: recall
    metric: failed_or_low
    arm_count: 10
    min_interval_h: 24
  tools:
  - read_doc
  - search_docs
  - list_files
  - recent_changes
  - get_related_docs
  - recall_stats
  - recall_feedback_stats
  model:
    model_id: "Qwen3.8-Flash-Next-UD-IQ3_XXS"
    base_url: "http://localhost:1244/v1"
    api_key: "sk-splash"
    context_window: 262144
    max_tokens: 16384
    temperature: 0.6
- name: "历史回顾"
  alias: narrator
  enabled: true
  cron: "0 10 * * 0"                  # 周日 10:00 周报
  target_dir: index/reports/narrator
  prompt: server/prompts/narrator.md
  report_dir: .reports/narrator
  max_rounds: 30
  timeout_s: 1800
  budget_runs_per_day: 1
  budget_max_proposals: 0
  tools:
  - read_doc
  - search_docs
  - list_files
  - recent_changes
  - get_related_docs
  model:
    model_id: "Qwen3.8-Flash-Next-UD-IQ3_XXS"
    base_url: "http://localhost:1244/v1"
    api_key: "sk-splash"
    context_window: 262144
    max_tokens: 16384
    temperature: 0.6
- name: "执行器"
  alias: executor
  enabled: false
  cron: "*/30 * * * *"
  target_dir: .
  prompt: server/prompts/consolidator.md     # 不加载，仅满足格式校验
  report_dir: index/reports/executor
  is_executor: true
  model:
    provider: openai
    model_id: xxx
    base_url: http://localhost:11434/v1
    api_key: "xxx"
- name: "中断分析"
  alias: abort-analyzer
  enabled: true
  cron: "0 4 * * 6"                # 周六 04:00 周频（低频——信号本就稀疏）
  target_dir: index                # 写边界 = 机器区（propose 零文件落，此值为名义 scope）
  prompt: server/prompts/abort-analyzer.md
  report_dir: .reports/abort-analyzer
  max_rounds: 20
  timeout_s: 1800
  budget_runs_per_day: 1
  budget_max_proposals: 5          # prompt 义务值（≤5 条写进 prompt 方法论）——全仓无执行点，非机制
  tools:                                            # 读×6 + propose（list_proposals = 防重③对账）；不持 write_doc（分界线，ADR-0004）
  - read_doc
  - search_docs
  - list_files
  - get_related_docs
  - recent_changes
  - list_proposals
  - propose
  verbs:                          # 四操作全 summary 型（r1.8：entity_index/errata/relatedness 均不进 verbs；落地=人 adopt 后手改 个人记忆.md）
  - summary
  model:                           # 本地档建议：reminder 含中断轮思考全文，选云端=思考出域（egress 台账兜底，红线 7 知情决策）
    model_id: "Qwen3.8-Flash-Next-UD-IQ3_XXS"
    base_url: "http://localhost:1244/v1"
    api_key: "sk-splash"
    context_window: 262144
    max_tokens: 16384
    temperature: 0.6
notifications:
  daily_cap: 20
